# PostgreSQL connection string used by Prisma
POSTGRES_URL="postgresql://neondb_owner:npg_0LSmuGOPyjg9@ep-square-violet-ak8f7sdn-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional Prisma/Postgres pool tuning
# These values are appended to POSTGRES_URL at runtime when not already present.
#
# PRISMA_POOL_MAX
# - Maps to the Postgres `connection_limit` query parameter
# - Use this to cap concurrent DB connections from Prisma
# - Good local/dev starting range: 5-10
# - Good small production starting range: 10-20
PRISMA_POOL_MAX=10

# PRISMA_POOL_TIMEOUT
# - Maps to the Postgres `pool_timeout` query parameter
# - Controls how long Prisma waits for a free pooled connection
# - Value is in seconds
# - Good starting range: 10-30
PRISMA_POOL_TIMEOUT=20
