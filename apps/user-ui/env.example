# ============================================
# FRONTEND ENVIRONMENT
# ============================================

# Public API base URL used by the frontend for all HTTP requests.
# Example local value:
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Public WebSocket URL used for realtime updates.
# If omitted, the app derives it from NEXT_PUBLIC_API_URL.
# Example local value:
NEXT_PUBLIC_WS_URL="ws://localhost:8080/ws"

# ============================================
# PERFORMANCE / DEBUGGING
# ============================================

# Optional: enable bundle analysis during build.
# Usage example:
# ANALYZE=true bun run build
ANALYZE=false
