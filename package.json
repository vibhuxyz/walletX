{
  "name": "wallet",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --concurrency=20",
    "build": "turbo run build --concurrency=20",
    "start": "turbo run start --concurrency=20",
    "lint": "turbo run lint",
    "check-format": "prettier --check \"**/*.{js,ts,jsx,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "cd packages/db-postgres && bunx prisma generate && cd ../db-mongo && bunx prisma generate",
    "db:migrate": "cd packages/db-postgres && bunx prisma migrate dev && cd ../db-mongo && bunx prisma db push",
    "db:seed": "cd packages/db-postgres && bun run db:seed",
    "db:reset": "bun run scripts/reset-db.ts",
    "docker:stop-old": "docker stop mongo_db rabbitmq redis_db postgres_db || true",
    "docker:up": " docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "check:services": "bun run scripts/check-services.ts",
    "setup": "bun install && bun run docker:up && sleep 30  &&  bun run db:generate && bun run db:migrate && bun run db:seed && bun run build",
    "db:studio:pg": "cd packages/db-postgres && bunx prisma studio",
    "ui:rabbitmq": "open http://localhost:15672",
    "ui:all": "bun run db:studio:pg  & bun run ui:rabbitmq",
    "dev:all": "bun run setup && bun run dev"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/node": "^20.12.7",
    "dotenv": "^17.3.1"
  }
}
