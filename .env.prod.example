# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production

# ============================================
# DATABASE CONNECTIONS (Production Cloud)
# ============================================
POSTGRES_URL="postgresql://username:password@your-postgres-host.com/neondb?sslmode=require&channel_binding=require"
PRISMA_POOL_MAX=20
PRISMA_POOL_TIMEOUT=30
MONGO_URL="mongodb+srv://username:password@your-mongo-cluster.mongodb.net/wallet?retryWrites=true&w=majority"
REDIS_DATABASE_URL="rediss://default:password@your-redis-host.com:6379"
RABBITMQ_URL="amqps://username:password@your-rabbitmq-host.cloudamqp.com/vhost"

# ============================================
# JWT & SECURITY (CHANGE IN PRODUCTION!)
# ============================================
JWT_SECRET="generate-a-cryptographically-secure-random-string-at-least-32-chars"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"
CSRF_SECRET="generate-a-cryptographically-secure-csrf-secret-key-32-chars"
COOKIE_SECRET="generate-a-cryptographically-secure-cookie-secret-key-32-chars"

# ============================================
# PASSWORD HASHING
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# SERVICE PORTS
# ============================================
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=6001
WALLET_SERVICE_PORT=6002
WORKER_SERVICE_PORT=6004
BANK_SERVICE_PORT=6005
REALTIME_SERVICE_PORT=6006

# ============================================
# SERVICE URLs (Docker Internal Network Communication)
# ============================================
AUTH_SERVICE_URL="http://auth-service:6001"
WALLET_SERVICE_URL="http://wallet-service:6002"
BANK_SERVICE_URL="http://bank-service:6005"
MERCHANT_SERVICE_URL="http://merchant-service:6007"
REALTIME_SERVICE_URL="http://realtime-service:6006"

# ============================================
# API KEYS (Service-to-Service)
# ============================================
WALLET_SERVICE_API_KEY="generate-a-secure-service-api-key-for-internal-auth"

# ============================================
# FRONTEND
# ============================================
FRONTEND_URL="https://yourwalletdomain.com"

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-smtp-api-key"
EMAIL_FROM="WalletX <no-reply@yourwalletdomain.com>"
BREVO_API_KEY=""

# ============================================
# MEDIA STORAGE (Cloudinary)
# ============================================
CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER=wallet-app-prod

# ============================================
# SMS CONFIGURATION (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ============================================
# BUSINESS RULES
# ============================================
MIN_TOPUP_AMOUNT=100
MAX_TOPUP_AMOUNT=100000
MIN_P2P_AMOUNT=10
MAX_P2P_AMOUNT=50000
TRANSACTION_FEE_PERCENT=0

# ============================================
# BACKGROUND ANALYTICS / CACHE REFRESH
# ============================================
ENABLE_ANALYTICS_REFRESH_JOB=true
ANALYTICS_REFRESH_INTERVAL_MS=900000
